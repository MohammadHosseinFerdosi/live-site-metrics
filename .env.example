# Origin only — no trailing slash. Used to resolve relative paths in urls.json / pages.csv
BASE_URL=https://example.com

# Optional: override the URL list file (default: config/urls.example.json)
# URLS_FILE=config/urls.json

# Optional: comma-separated absolute URLs (wins over URLS_FILE when set)
# METRICS_URLS=https://example.com/,https://example.com/about

# Browser engine: chromium | firefox | webkit (default: chromium)
# BROWSER=chromium

# Viewport profile: desktop | mobile (default: desktop)
# PROFILE=desktop

# Median of N navigations per URL (default: 3)
# RUNS=3

# Navigation timeout in ms (default: 60000)
# NAV_TIMEOUT_MS=60000

# Headed Chrome for debugging
# HEADED=0
